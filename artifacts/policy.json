{
  "policy_version": "fraud-risk-ops-v0.1.0-sklearn1.5.2",
  "release_stage": "public_reference",
  "default_model": "rf",
  "default_policy": "min_cost",
  "costs": {
    "false_positive": 5.0,
    "false_negative": 500.0
  },
  "models": {
    "rf": {
      "display_name": "RandomForest (Calibrated)",
      "default_policy": "min_cost"
    },
    "xgb": {
      "display_name": "XGBoost (Calibrated)",
      "default_policy": "min_cost"
    }
  },
  "policies": {
    "strict": {
      "thresholds": {
        "rf": 0.9,
        "xgb": 0.9
      },
      "description": "Reduce false positives and analyst load."
    },
    "balanced": {
      "thresholds": {
        "rf": 0.65,
        "xgb": 0.75
      },
      "description": "Default review-oriented operating point."
    },
    "min_cost": {
      "thresholds": {
        "rf": 0.0016451652802712843,
        "xgb": 0.0005568324704654515
      },
      "description": "Cost-minimizing operating point selected on the calibration split."
    },
    "lenient": {
      "thresholds": {
        "rf": 0.2,
        "xgb": 0.2
      },
      "description": "Increase fraud capture with higher review load."
    }
  }
}
