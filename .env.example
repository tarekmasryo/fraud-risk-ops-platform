# Example environment file (DO NOT put real secrets here)

# App mode
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=text
CORS_ALLOW_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# Streamlit UI -> FastAPI: server-controlled origin (never browser-editable)
# - local:  http://127.0.0.1:8000
# - compose: http://api:8000
# - external: use HTTPS, protect the Streamlit UI before forwarding any API secret
# Reject URL userinfo, paths, queries, and fragments; API_BASE_URL is a legacy fallback.
FRAUD_API_URL=http://127.0.0.1:8000

# Optional Streamlit UI auth forwarding for protected API runs.
# These remain server-side and are never prefilled into browser-visible widgets.
# Public Streamlit hosting without viewer authentication is NOT an approved deployment.
FRAUD_API_KEY=
FRAUD_BEARER_TOKEN=

# Runtime artifacts
MODEL_ARTIFACT_DIR=artifacts
# Fail closed by default if serialized artifacts do not match the expected runtime.
STRICT_ARTIFACT_RUNTIME=true
ALLOW_ARTIFACT_COMPATIBILITY_FALLBACK=false

# Persistence
# Default uses local SQLite for frictionless technical review.
DATABASE_URL=sqlite:///./data/fraud_ops.db

# Jobs / queue configuration
# RUN_JOBS_IN_API=true keeps local one-process runs frictionless.
# Docker Compose sets it to false so the worker consumes persisted jobs.
REDIS_URL=redis://redis:6379/0
MAX_BATCH_RECORDS=1000
RUN_JOBS_IN_API=true
WORKER_POLL_SECONDS=2

# Auth
# Keep false for local technical review. Set true for protected API runs.
REQUIRE_AUTH=false
JWT_SECRET_KEY=change-me-for-protected-mode
API_KEY_HASH_SECRET=replace-with-a-strong-hmac-secret
DEMO_API_KEY=replace-with-a-strong-local-key
# Optional HMAC-SHA256 digest of the API key using API_KEY_HASH_SECRET.
# If set, the raw DEMO_API_KEY value is not used for comparison.
DEMO_API_KEY_HASH=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-for-protected-mode

# UI fallback behavior
ALLOW_LOCAL_FALLBACK=true

# Monitoring
PROMETHEUS_ENABLED=true

# Grafana local credentials used by docker-compose.yml
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
